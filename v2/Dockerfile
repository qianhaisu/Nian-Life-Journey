# Nianlife V2 — Web-only container baseline (MIG-C-Phase3C1).
#
# Scope: runs `next start`-equivalent standalone server only. Does NOT run the
# Organizer worker or any cron — that is Phase 3C2, wired separately and default-off.
# This image never talks to Neon/R2/OSS/Vercel at build time; all of that is
# runtime configuration supplied on ECS via environment variables (see .env.example
# in the repo for the full variable list — no values are baked into this image).

# ---- deps: install once, cached across builder reruns ----
FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

# ---- builder: type-checked production build ----
FROM node:22-bookworm-slim AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# DB connections are lazy (v2/lib/db/client.ts) — the build never opens one, so no
# DATABASE_URL or other runtime secret is needed at this stage.
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# ---- runner: minimal production image, non-root ----
FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN groupadd --system --gid 1001 nodejs \
  && useradd --system --uid 1001 --gid nodejs nextjs

# `output: "standalone"` (next.config.ts) produces a trimmed server bundle plus the
# node_modules subset it actually needs — this is the only runtime dependency tree
# copied into the image, not the full node_modules from the deps stage.
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

USER nextjs
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

# server.js is generated by the standalone build (.next/standalone/server.js).
CMD ["node", "server.js"]
