R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
MEMORY_ORGANIZER=rule
AI_ORGANIZER_ENABLED=false
AI_PROVIDER=openai
AI_MODEL=
AI_API_KEY=
AI_API_BASE_URL=
AI_TIMEOUT_MS=
AI_ORGANIZER_MAX_IMAGE_INPUTS=
AI_ORGANIZER_DEBUG=false
