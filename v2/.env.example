# json (default) or postgres. postgres requires DATABASE_URL — there is no automatic fallback if
# it's missing or unreachable; fix the config or switch this back to json.
REPOSITORY_BACKEND=json
DATABASE_URL=postgresql://user:password@localhost:5432/nianlife
STORAGE_ROOT=.data/media
AUTH_SECRET=replace-in-deployment-only
INGESTION_TOKEN=
# Shared secret for the manual Organizer-worker HTTP trigger. Keep it blank
# until that worker is explicitly enabled after migration acceptance.
CRON_SECRET=
# Defaults to false. Set exactly "true" only after migration acceptance to allow the web
# process and the authenticated organizer endpoint to drain queued Organizer jobs.
ORGANIZER_WORKER_ENABLED=false
# Used only by the local `quark:ingest-artifact` CLI to reach this app's ingestion API; never commit a real deployment URL/token.
NIANLIFE_INGESTION_URL=
MEDIA_STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
MEMORY_ORGANIZER=rule
AI_ORGANIZER_ENABLED=false
AI_PROVIDER=openai
AI_MODEL=
AI_ORGANIZER_PROMPT_VERSION=v2
AI_API_KEY=
AI_API_BASE_URL=
GEMINI_API_KEY=
AI_TIMEOUT_MS=
AI_ORGANIZER_MAX_IMAGE_INPUTS=
AI_ORGANIZER_DEBUG=false

# HEALTH-03 家长健康记录 (/health/record). 缺省 = 功能关闭；不会回退到任何现有账本或业务库。
# 没有健康登录：“妈妈 / 爸爸”只是录入人选择，不是验证过的账号（2026-09-21 起，病历数据允许公开访问）。
# 私有数据根目录必须在仓库之外。
HEALTH_RECORD_ROOT=
# 可选：额外允许写入的来源（逗号分隔的完整 origin）；同源写入总是允许
HEALTH_RECORD_ALLOWED_ORIGINS=

# 健康页 (/health) 的只读输入（2026-09-21）。全部可选、必须是仓库之外的绝对路径；缺省 = 对应内容不接通。
# HEALTH_HISTORY_LEDGER（历史账本目录）、HEALTH_PAGE_INTERVALS / _MATERIALS / _DERIVED（已核对的区间、措施、派生记录）、
# HEALTH_PAGE_ANALYSES / _EVIDENCE（已采用的病程分析与医学证据登记）、HEALTH_PAGE_MATERIAL_ROOT（措施来源文件根目录）、
# HEALTH_HISTORY_ORIGINAL_ROOTS 与 HEALTH_HISTORY_ORIGINAL_ROOT_MAP（医院原件的允许根目录，及"账本里记录的根目录=服务器目录"的映射）。
