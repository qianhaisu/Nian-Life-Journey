# nianlife.cn 公网入口（ECS 实际部署用）。
#
# 接入方式：Caddy 容器以 `--network host` 运行，直接占用宿主机 80/443，反代到宿主机
# 127.0.0.1:3000——Web 容器由 docker run 启动，只发布在 127.0.0.1:3000（见
# scripts/deploy-ecs-public.sh）。bridge 网络里的容器连不到宿主机回环地址，所以这里不用
# bridge + host.docker.internal，也不用只在 compose 网络内才能解析的 web:3000
# （那是 compose.production.yaml + Caddyfile 的私有基线，当前 ECS 并不用它运行）。
#
# 证书：Caddy 自动 HTTPS（Let's Encrypt，失败时回落 ZeroSSL，两者 2026-09-15 从 ECS 均可达）。
# 证书和账户存放在 /data，自动续期状态在 /config；两者都挂具名卷，重建容器不重新申请。
# HTTP 请求由 Caddy 自动 308 跳转 HTTPS。
{
	servers {
		# 只开 HTTP/1.1 与 HTTP/2：安全组未确认放行 UDP 443，不对外宣告 HTTP/3。
		protocols h1 h2
	}
}

# 公网只读：只有 GET/HEAD 会转发给应用，其余方法（含 Server Action 的 POST）在这里直接 405，
# 不进应用。管理写入走 SSH 隧道直连 127.0.0.1:3000，不经过这个入口。
# /api/internal/* 另外整段 404：organizer-worker 的 GET 等同 POST，内部接口不对公网开放。
# 图片、视频的 Range 请求是 GET，照常转发。
nianlife.cn {
	# 访问日志（2026-09-20 加）。事故当天全站图片打不开约 2.5 小时，排查时发现这里根本没有
	# 访问日志，还原不出请求量——当时误以为"6 小时只有 9 个图片请求"，其实那是从 Caddy 自己的
	# 运行日志里 grep 出来的错误行。没有它就只能 ssh 进容器的网络命名空间去数 socket。
	#
	# 落在 /data（已有的具名卷 nianlife-caddy-data）而不是容器内的临时路径：容器重建后日志还在，
	# 也不会把镜像层撑大。加日志只需 scp + `caddy reload`，不重建容器，证书不受影响。
	#
	# 隐私：来访 IP 按 /16 打码。读者只有家里三个人，"谁在什么时候看了哪张孩子的照片"不该留成
	# 一份可检索的记录；而要回答"每秒多少个图片请求、哪条路径在超时"，打码后的日志完全够用。
	# Cookie 与 Authorization 由 Caddy 默认抹除，这里再去掉 User-Agent。
	log {
		output file /data/log/access.log {
			roll_size 20MiB
			roll_keep 5
			roll_keep_for 720h
		}
		format filter {
			wrap json
			fields {
				request>remote_ip ip_mask 16 32
				request>client_ip ip_mask 16 32
				request>headers>User-Agent delete
			}
		}
	}

	@notRead not method GET HEAD
	handle @notRead {
		header Allow "GET, HEAD"
		respond "Method Not Allowed" 405
	}
	handle /api/internal/* {
		respond "Not Found" 404
	}
	handle {
		encode zstd gzip
		reverse_proxy 127.0.0.1:3000
	}
}

# www 只做跳转：HTTPS 和 HTTP 都一跳到主域名，保留路径和查询串。
www.nianlife.cn {
	redir https://nianlife.cn{uri} 308
}

http://www.nianlife.cn {
	redir https://nianlife.cn{uri} 308
}
